# Dependencies
node_modules/
*/node_modules/
package-lock.json.bak
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment Variables (Keep secrets local!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
backend/.env.local
frontend/.env
frontend/.env.local

# Allow example config template
!backend/.env.example
!.env.example

# Production Builds
dist/
frontend/dist/
build/

# Uploads (Keep folder structure via .gitkeep, ignore runtime test uploads)
backend/uploads/*
!backend/uploads/.gitkeep

# macOS & OS artifacts
.DS_Store
.AppleDouble
.LSOverride
Icon
Thumbs.db

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo

# Logs
logs/
*.log
